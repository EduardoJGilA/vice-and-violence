<div class="vv-sheet {{#if isDowned}}is-downed{{/if}}">

  {{!-- ============ BANNER: portrait, identity, badges, vitals, tabs ============ --}}
  <header class="vv-banner">
    <div class="vv-bn-top">
      <figure class="vv-portrait">
        <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="Change portrait">
        {{#if isDowned}}<span class="vv-stamp">Downed</span>{{/if}}
        {{#if system.isZombie}}<span class="vv-stamp vv-stamp-zombie">Zombie</span>{{/if}}
      </figure>

      <div class="vv-identity">
        <input class="vv-name" type="text" name="name" value="{{actor.name}}" placeholder="Name" aria-label="Name">
        <p class="vv-subtitle">{{subtitle}}</p>
        <div class="vv-picks">
          <label class="vv-pick"><span>Race</span>
            <span class="vv-pick-box">
              <select data-pick="race" aria-label="Race"><option value="">— choose —</option>{{#each pickers.race.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{#if racePickNeeded}}<button type="button" class="vv-pill" data-action="racePick" data-tooltip="Choose which abilities get the racial bonus">{{racePickText}}</button>{{/if}}
            </span></label>
          <label class="vv-pick"><span>Birthsign</span>
            <span class="vv-pick-box">
              <select data-pick="birthsign" aria-label="Birthsign"><option value="">— choose —</option>{{#each pickers.birthsign.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </span></label>
          {{#if pickers.boons}}<label class="vv-pick"><span>Boon</span>
            <span class="vv-pick-box"><select data-item-id="{{pickers.boons.id}}" data-item-field="system.chosen" aria-label="Boon">{{#each pickers.boons.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></span></label>{{/if}}
          <div class="vv-pick"><span>Class</span>
            <span class="vv-pick-box vv-chips">
              {{#each classes}}<span class="vv-chip"><a data-action="open" data-id="{{id}}">{{name}}</a><button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></span>{{/each}}
              <select class="vv-addclass" data-pick="class" aria-label="Add a class"><option value="">{{#if classes}}+ add{{else}}— choose —{{/if}}</option>{{#each pickers.class.options}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            </span></div>
        </div>
      </div>

      <label class="vv-level" data-tooltip="Level (0 to 10)">
        <span>Level</span>
        <input type="number" name="system.level" value="{{system.level}}" min="0" max="10" aria-label="Level">
      </label>
    </div>

    <div class="vv-bn-mid">
      <button type="button" class="vv-shield" data-action="roll" data-roll="defence" data-tooltip="Defend: roll armour save + Moxie">
        <span class="vv-shield-num">{{armourText}}</span>
        <span class="vv-shield-label">Armour</span>
      </button>

      <div class="vv-hexes" role="group" aria-label="Abilities">
        {{#each abilities}}
        <div class="vv-hexwrap">
          <button type="button" class="vv-hex" data-action="roll" data-roll="ability:{{key}}" data-tooltip="Roll d20 + {{label}}">
            <span class="vv-hex-label">{{label}}</span>
            <span class="vv-hex-num">{{text}}</span>
          </button>
          <label class="vv-hex-base" data-tooltip="{{#if mod}}Base {{value}} + racial {{mod}}{{else}}Base score{{/if}}">
            <input type="number" name="system.{{key}}" value="{{value}}" min="-4" max="7" aria-label="{{label}} base">
          </label>
        </div>
        {{/each}}
      </div>

      <div class="vv-meters">
        <div class="vv-meter vv-meter-life {{#if life.low}}is-low{{/if}}" style="--f: {{life.f}}">
          <span class="vv-meter-label">LIFE <button type="button" class="vv-link" data-action="roll" data-roll="life" data-tooltip="Roll 5 + d6 + Moxie">roll</button></span>
          <span class="vv-meter-num"><input type="number" name="system.life.value" value="{{life.value}}" min="0" aria-label="LIFE"><i>/</i><input class="vv-max" type="number" name="system.life.max" value="{{life.max}}" min="0" aria-label="Maximum LIFE"></span>
          <span class="vv-meter-bar"></span>
        </div>
        <div class="vv-meter-pair">
          <div class="vv-meter vv-meter-exertion {{#if exertion.low}}is-low{{/if}}" style="--f: {{exertion.f}}">
            <span class="vv-meter-label">Exertion</span>
            <span class="vv-meter-num"><input type="number" name="system.exertion.value" value="{{exertion.value}}" min="0" aria-label="Exertion"><i>/</i><input class="vv-max" type="number" name="system.exertion.max" value="{{exertion.max}}" min="0" aria-label="Maximum Exertion"></span>
            <span class="vv-meter-bar"></span>
          </div>
          <div class="vv-meter vv-meter-mana {{#if spellUses.low}}is-low{{/if}}" style="--f: {{spellUses.f}}">
            <span class="vv-meter-label">Spell Uses</span>
            <span class="vv-meter-num"><input type="number" name="system.spellUses.value" value="{{spellUses.value}}" min="0" aria-label="Spell Uses"><i>/</i><input class="vv-max" type="number" name="system.spellUses.max" value="{{spellUses.max}}" min="0" aria-label="Maximum Spell Uses"></span>
            <span class="vv-meter-bar"></span>
          </div>
        </div>
      </div>
    </div>

    <nav class="tabs vv-tabs" data-group="primary" aria-label="Sheet sections">
      {{#each tabs}}<button type="button" class="{{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-pressed="{{active}}"><i class="{{icon}}" aria-hidden="true"></i>{{localize label}}</button>{{/each}}
      <span class="vv-wordmark" aria-hidden="true">Vice &amp; Violence</span>
    </nav>
  </header>

  {{!-- ============ MAIN: sidebar + content ============ --}}
  <div class="vv-main">

    <aside class="vv-side" aria-label="Quick panel">
      <section class="vv-card">
        <h3>Checks</h3>
        <div class="vv-line">
          <select data-stealth-dc aria-label="Enemy alertness">{{#each stealthOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <button type="button" class="vv-btn vv-primary" data-action="roll" data-roll="stealth:x" data-tooltip="Stealth: d20 minus armour save. No ability is added.">Stealth</button>
        </div>
        {{#if isNpc}}
        <div class="vv-line">
          <select name="system.initiative" aria-label="Initiative">{{#each initiativeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <input type="text" name="system.attackDie" value="{{system.attackDie}}" aria-label="Attack die">
          <button type="button" class="vv-btn vv-primary" data-action="roll" data-roll="npcattack">Attack</button>
        </div>
        {{/if}}
      </section>

      <section class="vv-card">
        <h3>Supplies</h3>
        <dl class="vv-stats">
          {{#unless isNpc}}
          <label class="vv-stat"><dt>Rations</dt><dd><input type="number" name="system.rations" value="{{system.rations}}" min="0" aria-label="Rations"></dd></label>
          <label class="vv-stat"><dt>Water</dt><dd><input type="number" name="system.water" value="{{system.water}}" min="0" aria-label="Water"></dd></label>
          {{/unless}}
          <label class="vv-stat"><dt>Jade</dt><dd><input type="number" name="system.jade" value="{{system.jade}}" min="0" aria-label="Jade"></dd></label>
          <label class="vv-stat"><dt>Disposition</dt><dd><input type="number" name="system.disposition" value="{{system.disposition}}" aria-label="Disposition"></dd></label>
        </dl>
      </section>

      <section class="vv-card">
        <h3>Status</h3>
        <div class="vv-chips">
          {{#each statuses}}<button type="button" class="vv-chip vv-chip-btn" data-action="toggleStatus" data-status="{{id}}" data-tooltip="{{description}}">{{name}} <span aria-hidden="true">×</span></button>
          {{else}}<span class="vv-empty">Nothing afflicts you. Yet.</span>{{/each}}
        </div>
        <div class="vv-death">
          <label>Downed <input type="number" name="system.downedTurns" value="{{system.downedTurns}}" min="0" max="3" aria-label="Downed turns"><small>/3</small></label>
          <label class="vv-check"><input type="checkbox" name="system.isZombie" {{#if system.isZombie}}checked{{/if}}> Zombie</label>
          <button type="button" class="vv-link" data-action="roll" data-roll="death" data-tooltip="Roll d20 on the death table">death roll</button>
        </div>
      </section>
      <div class="vv-mascot" aria-hidden="true"><span class="vv-mascot-says">Don't look at me.</span></div>
    </aside>

    <div class="vv-content">

      {{!-- ---------- DETAILS ---------- --}}
      <section class="tab {{tabs.details.cssClass}}" data-group="primary" data-tab="details">
        <div class="vv-two">
          {{#unless isNpc}}
          <div class="vv-card">
            <h3>Background</h3>
            <input type="text" name="system.background" value="{{system.background}}" placeholder="Farmer, Alchemist, Urchin..." aria-label="Background">
            <textarea name="system.backgroundNotes" rows="6" aria-label="Background benefits" placeholder="What your background gives you: starting bonus, Vice, skills...">{{system.backgroundNotes}}</textarea>
          </div>
          <div class="vv-card">
            <h3>Booze, drugs &amp; milk</h3>
            <textarea name="system.booze" rows="5" aria-label="Booze, Drugs and Milk">{{system.booze}}</textarea>
            <div class="vv-line vv-pair">
              <label class="vv-mini"><span>Max sexual partners</span><input type="number" name="system.maxPartners" value="{{system.maxPartners}}" min="0" max="4"></label>
              <label class="vv-mini"><span>Refractory (min)</span><input type="number" name="system.refractoryPeriod" value="{{system.refractoryPeriod}}" min="0"></label>
            </div>
          </div>
          {{else}}
          <div class="vv-card vv-span">
            <h3>Notes</h3>
            <textarea name="system.backgroundNotes" rows="6" aria-label="Notes about this creature" placeholder="Notes about this creature">{{system.backgroundNotes}}</textarea>
          </div>
          {{/unless}}
        </div>

        <div class="vv-group" style="--cols: minmax(0, 1fr) minmax(0, 1.4fr) 2rem">
          <div class="vv-group-bar"><h3>Vices</h3><span class="vv-count">{{vices.length}}</span>
            <span class="vv-group-actions">
              <button type="button" class="vv-btn" data-action="newVice" data-tooltip="Roll d50 on the Vice table">Roll d50</button>
            </span></div>
          <div class="vv-thead"><span>Vice</span><span>Effect</span><span></span></div>
          {{#each vices}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a><span class="vv-sub">{{effect}}</span>
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></div>
          {{else}}<div class="vv-tr vv-empty-row">No vices. Lucky you.</div>{{/each}}
          <div class="vv-add-row">
            <select data-new-vice aria-label="Vice to add">{{#each viceOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            <button type="button" class="vv-btn" data-action="addVice" data-tooltip="Add the chosen vice by hand">Add</button>
          </div>
        </div>
      </section>

      {{!-- ---------- COMBAT ---------- --}}
      <section class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
        <div class="vv-group" style="--cols: minmax(0, 1.6fr) 3rem 3.6rem 4.6rem 2rem">
          <div class="vv-group-bar"><h3>Armour</h3><span class="vv-count">{{armours.length}}</span>
            <span class="vv-group-actions">
              <select name="system.armourSave" aria-label="Armour die (no armour item)" {{#if armourLocked}}disabled{{/if}}>{{#each armourOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              <b>+</b><input type="number" name="system.armourBonus" value="{{system.armourBonus}}" min="0" aria-label="Armour bonus" {{#if armourLocked}}disabled{{/if}}>
            </span></div>
          <div class="vv-thead"><span>Name</span><span>Die</span><span>Upgrade</span><span>Worn</span><span></span></div>
          {{#each armours}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a><span class="vv-sub">{{die}}</span>
            <input class="vv-bonus" type="number" min="0" max="10" value="{{bonus}}" data-item-id="{{id}}" data-item-field="system.bonus" aria-label="Upgrade bonus for {{name}}" data-tooltip="Optional +1 upgrades">
            <button type="button" class="vv-btn {{#if equipped}}is-on{{/if}}" data-action="equip" data-id="{{id}}" aria-pressed="{{equipped}}">{{#if equipped}}Worn{{else}}Wear{{/if}}</button>
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></div>
          {{else}}<div class="vv-tr vv-empty-row">No armour item. Set the die above, or drop an armour here.</div>{{/each}}
        </div>

        <div class="vv-group" style="--cols: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) 3.6rem 4.8rem 2rem">
          <div class="vv-group-bar"><h3>Weapons</h3><span class="vv-count">{{weapons.length}}</span>
            <span class="vv-group-actions"><button type="button" class="vv-btn" data-action="newWeapon">New weapon</button></span></div>
          <div class="vv-thead"><span>Name</span><span>Type</span><span>Material</span><span>Damage</span><span>Roll</span><span></span></div>
          {{#each weapons}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a>
            <select data-item-id="{{id}}" data-item-field="system.kind" aria-label="Weapon type">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <select data-item-id="{{id}}" data-item-field="system.material" aria-label="Material">{{#each materials}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <span class="vv-sub">{{text}}</span>
            <button type="button" class="vv-btn vv-primary" data-action="roll" data-roll="item:{{id}}" data-tooltip="Roll damage: die + material + Brawn">Damage</button>
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></div>
          {{else}}<div class="vv-tr vv-empty-row">Unarmed. Drop a weapon on the sheet, or create one.</div>{{/each}}
        </div>

        <div class="vv-group">
          <div class="vv-group-bar"><h3>Conditions</h3><span class="vv-count">{{statuses.length}}</span></div>
          <div class="vv-conditions">
            {{#each conditions}}
            <button type="button" class="vv-cond {{#if active}}is-active{{/if}}" role="switch" aria-checked="{{active}}" data-action="toggleStatus" data-status="{{id}}">
              <span class="vv-switch" aria-hidden="true"></span>
              <span class="vv-cond-name">{{name}}</span>
              <span class="vv-cond-text">{{description}}</span>
            </button>
            {{/each}}
          </div>
        </div>
      </section>

      {{!-- ---------- MAGIC ---------- --}}
      <section class="tab {{tabs.magic.cssClass}}" data-group="primary" data-tab="magic">
        <div class="vv-group" style="--cols: 5.4rem minmax(0, 1fr) 3.6rem 4.4rem 2rem">
          <div class="vv-group-bar"><h3>Spells</h3><span class="vv-count">{{spells.length}}</span>
            <span class="vv-group-actions">
              <label class="vv-inline-field" data-tooltip="Blood Magic: up to two dice, each up to d10">Blood dice <input type="text" data-blood-dice value="d10" aria-label="Blood Magic dice"></label>
            </span></div>
          <div class="vv-thead"><span>School</span><span>Name</span><span>Cost</span><span>Cast</span><span></span></div>
          {{#each spells}}<div class="vv-tr"><span class="vv-school vv-school-{{school}}">{{school}}</span><a data-action="open" data-id="{{id}}">{{name}}</a><span class="vv-sub">{{cost}}</span>
            <button type="button" class="vv-btn vv-primary" data-action="roll" data-roll="item:{{id}}">Cast</button>
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Forget {{name}}" data-tooltip="Forget this spell">×</button></div>
          {{else}}<div class="vv-tr vv-empty-row">No spells learned yet. Pick one below.</div>{{/each}}
          <div class="vv-add-row">
            <select data-new-spell aria-label="Spell to learn"><option value="">— learn a spell —</option>{{#each spellGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</optgroup>{{/each}}</select>
            <button type="button" class="vv-btn" data-action="learnSpell">Learn</button>
          </div>
        </div>

        <div class="vv-two">
          <div class="vv-group" style="--cols: minmax(0, 1fr) 6.2rem 4.4rem 2rem">
            <div class="vv-group-bar"><h3>Magic staffs</h3><span class="vv-count">{{staffs.length}}</span>
              <span class="vv-group-actions"><button type="button" class="vv-btn" data-action="newStaff">New</button></span></div>
            <div class="vv-thead"><span>Name</span><span>Uses</span><span>Held</span><span></span></div>
            {{#each staffs}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a>
              <span class="vv-charges">
                <input type="number" min="0" value="{{value}}" data-item-id="{{id}}" data-item-field="system.charges.value" aria-label="Uses left of {{name}}"><b>/</b>
                <input type="number" min="0" value="{{max}}" data-item-id="{{id}}" data-item-field="system.charges.max" aria-label="Maximum uses of {{name}}"></span>
              <button type="button" class="vv-btn {{#if equipped}}is-on{{/if}}" data-action="equip" data-id="{{id}}" aria-pressed="{{equipped}}">{{#if equipped}}Held{{else}}Hold{{/if}}</button>
              <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></div>
            {{else}}<div class="vv-tr vv-empty-row">No staff. Each use absorbs one Fuck Up.</div>{{/each}}
          </div>

          <div class="vv-group">
            <div class="vv-group-bar"><h3>Fuck Up table</h3></div>
            <div class="vv-fu">
              <div class="vv-line">
                <button type="button" class="vv-btn vv-primary" data-action="rollFuckUp" data-tooltip="Roll d11 and post the effect in chat">Roll d11</button>
                <select data-fuckup-pick aria-label="Fuck Up result to show">{{#each fuckUpOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
                <button type="button" class="vv-btn" data-action="rollFuckUp" data-pick="chosen" data-tooltip="Post the chosen result in chat">Show</button>
              </div>
              <p class="vv-note">Turned into a cast at level-up: a lit star no longer hurts you.</p>
              <div class="vv-stars" role="group" aria-label="Fuck Up results turned into a successful cast">
                {{#each fuckUps}}<label class="vv-star" data-tooltip="{{effect}}"><input type="checkbox" name="system.fuckUpTable.{{i}}" {{#if checked}}checked{{/if}}><span>{{n}}</span></label>{{/each}}
              </div>
            </div>
          </div>
        </div>
      </section>

      {{!-- ---------- SKILLS ---------- --}}
      <section class="tab {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
        {{#each featGroups}}
        <div class="vv-group" style="--cols: minmax(0, 1fr) minmax(0, 0.8fr) 2rem">
          <div class="vv-group-bar"><h3>{{label}}</h3><span class="vv-count">{{feats.length}}</span></div>
          {{#each feats}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a><span class="vv-sub">{{requirement}}</span>
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Forget {{name}}" data-tooltip="Remove this feat">×</button></div>{{/each}}
        </div>
        {{else}}
        <p class="vv-empty vv-lead">No feats yet. Choose a class below, then one of its feats.</p>
        {{/each}}
        <div class="vv-add-row vv-add-feat">
          <select data-feat-class aria-label="Class">{{#each featPicker.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <select data-new-feat aria-label="Feat to learn"><option value="">— learn a feat —</option>{{#each featPicker.options}}<option value="{{value}}" data-class="{{classType}}" {{#if hidden}}hidden disabled{{/if}}>{{label}}</option>{{/each}}</select>
          <button type="button" class="vv-btn" data-action="learnFeat">Learn</button>
        </div>
        {{#unless isNpc}}
        <div class="vv-card">
          <h3>Other skills &amp; abilities</h3>
          <textarea name="system.abilities" rows="5" aria-label="Skills and abilities" placeholder="Anything not in the feat list: martial skills, house rules, class abilities...">{{system.abilities}}</textarea>
        </div>
        {{/unless}}
      </section>

      {{!-- ---------- GEAR ---------- --}}
      <section class="tab {{tabs.gear.cssClass}}" data-group="primary" data-tab="gear">
        <div class="vv-card">
          <h3>Inventory</h3>
          <textarea name="system.inventory" rows="6" aria-label="Inventory" placeholder="Write what you carry: coins, food, tools, loot...">{{system.inventory}}</textarea>
        </div>
        <div class="vv-group" style="--cols: minmax(0, 1fr) 5.4rem 2rem">
          <div class="vv-group-bar"><h3>Gear items</h3><span class="vv-count">{{gear.length}}</span>
            <span class="vv-group-actions">
              <button type="button" class="vv-btn" data-action="startingSupplies" data-tooltip="d10 x 10 jade and six rolls on the Adventuring Supplies d100 table">Roll starting supplies</button>
            </span></div>
          <div class="vv-thead"><span>Name</span><span>Quantity</span><span></span></div>
          {{#each gear}}<div class="vv-tr"><a data-action="open" data-id="{{id}}">{{name}}</a>
            <input class="vv-bonus" type="number" min="0" value="{{quantity}}" data-item-id="{{id}}" data-item-field="system.quantity" aria-label="Quantity of {{name}}">
            <button type="button" class="vv-x" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}">×</button></div>
          {{else}}<div class="vv-tr vv-empty-row">Empty. Drop items anywhere on the sheet.</div>{{/each}}
          <div class="vv-add-row">
            <select data-new-type aria-label="Item type to add">{{#each itemTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
            <button type="button" class="vv-btn" data-action="create">New item</button>
          </div>
        </div>
      </section>

      {{!-- ---------- NOTES ---------- --}}
      <section class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">
        <div class="vv-card vv-editor">
          <h3>Notes</h3>
          {{formInput notesField value=system.notes enriched=notesHTML toggled=true name="system.notes"}}
        </div>
      </section>

    </div>
  </div>
</div>
